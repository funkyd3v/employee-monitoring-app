# Copy to .env and adjust. All values are optional — defaults are shown.

# Application mode: "local" (dummy/local providers) or "api" (future backend).
# EM_MODE=local

# Verbose logging for local debugging.
# EM_LOG_LEVEL=INFO

# Override the per-user data directory (defaults:
#   Windows: %LOCALAPPDATA%\EmployeeMonitoring
#   other:   ~/.local/share/employee-monitoring-agent)
# EM_DATA_DIR=

# Dev-time dummy authentication (Phase 3). NEVER the default in production code.
# EM_DUMMY_EMAIL=employee@example.com
# EM_DUMMY_PASSWORD=

# Default screenshot interval in seconds (min. 60) and idle threshold in seconds.
# EM_SCREENSHOT_INTERVAL_SECONDS=60
# EM_IDLE_THRESHOLD_SECONDS=300