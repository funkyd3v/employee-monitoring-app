# Copy to .env and adjust. All values are optional — defaults are shown.

# Application mode: "local" (dummy providers, no network) or "api" (real
# backend). In api mode the agent signs in with real employee credentials and
# uploads its outbox; see docs/API_CONTRACT.md.
# EM_MODE=local

# Backend API base URL, including the version prefix. Required when
# EM_MODE=api — a missing or malformed value fails at startup rather than
# silently falling back to local-only recording.
# EM_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Timeouts for backend calls. Connect stays short so the background sync
# worker never stalls on an unreachable host; the read/write timeout is longer
# because a multi-megabyte screenshot upload is a legitimately slow write.
# EM_API_CONNECT_TIMEOUT_SECONDS=5
# EM_API_TIMEOUT_SECONDS=30

# Optional JSON file that replaces or extends the built-in wire contract
# (paths, request field lists, user-envelope keys). Leave empty to use the
# contract documented in docs/API_CONTRACT.md. Use it to add an endpoint the
# agent has never heard of, or to point it at a differently-shaped backend,
# without a new build. A path that does not exist, or a malformed file, fails
# at startup on purpose — see docs/API_CONTRACT.md § Adapting the client.
# EM_API_CONTRACT_PATH=

# Where the session token is kept: "auto" (OS keyring, else in-memory only),
# "keyring" (require the OS keyring), "none" (memory only). "dev-file" is a
# development-only opt-in and is refused in api mode.
# EM_CREDENTIAL_BACKEND=auto

# Verbose logging for local debugging.
# EM_LOG_LEVEL=INFO

# Override the per-user data directory (defaults:
#   Windows: %LOCALAPPDATA%\EmployeeMonitoring
#   other:   ~/.local/share/employee-monitoring-agent)
# EM_DATA_DIR=

# Dev-time dummy authentication (Phase 3). NEVER the default in production code.
# EM_DUMMY_EMAIL=employee@example.com
# EM_DUMMY_PASSWORD=

# Default screenshot interval in seconds (min. 60) and idle threshold in seconds.
# EM_SCREENSHOT_INTERVAL_SECONDS=60
# EM_IDLE_THRESHOLD_SECONDS=300